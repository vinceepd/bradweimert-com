---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Privacy Policy | Brad Weimert"
  description="Privacy policy for bradweimert.com."
>
  <main>
    <section class="mx-auto max-w-3xl px-6 py-20 text-paper/80">
      <p class="text-sm font-semibold uppercase tracking-[0.3em] text-teal">Legal</p>
      <h1 class="mt-4 font-display text-4xl text-paper">Privacy Policy</h1>
      <p class="mt-8 leading-relaxed">
        This page is a placeholder carried over from the previous site. Replace this copy with the current privacy policy before launch.
      </p>
    </section>
  </main>
</BaseLayout>
